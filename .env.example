# Copy this file to .env and fill in your values
# Never commit .env to git

# App
VITE_APP_NAME=Kinora
VITE_APP_URL=https://mykinora.com

# Platform (web app) URL - used for "Log in" and "Sign up" links from the landing page
# Set to the deployed app domain in production
VITE_PLATFORM_URL=https://app.mykinora.com

# Backend API URL - used by the public application form
VITE_API_URL=https://kinora-backend.mangorock-bef5a05b.eastus2.azurecontainerapps.io

# Stripe (add when payment integration is ready)
# VITE_STRIPE_PUBLIC_KEY=pk_live_...

# Zoom (add when SDK integration is ready)
# VITE_ZOOM_SDK_KEY=...

# Analytics (e.g. Plausible or PostHog - privacy-first)
# VITE_ANALYTICS_ID=...
